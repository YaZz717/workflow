# ---------------------------------------------------------------------------
# WorkFlow — variables d'environnement
# Copiez ce fichier en `.env` et adaptez si besoin.
# ---------------------------------------------------------------------------

# Base de données (correspond au service `db` de docker-compose.yml)
DATABASE_URL="postgresql://workflow:workflow@localhost:5433/workflow?schema=public"

# Auth.js — générez un secret avec : npx auth secret
AUTH_SECRET="remplacez-moi-par-un-secret-aleatoire-long"
AUTH_URL="http://localhost:3002"
AUTH_TRUST_HOST="true"

# URL publique de l'application (liens dans les emails)
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Envoi d'emails (Resend). Laissez vide en dev : les emails s'affichent dans la console.
RESEND_API_KEY=""
EMAIL_FROM="WorkFlow <no-reply@workflow.local>"

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="10"

# Rate limiting connexion
LOGIN_MAX_ATTEMPTS="5"
LOGIN_WINDOW_MINUTES="15"

# Secret pour l'endpoint de notifications d'échéance (/api/cron/deadlines).
# Laisser vide désactive l'endpoint. À appeler quotidiennement :
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" http://localhost:3002/api/cron/deadlines
CRON_SECRET=""
